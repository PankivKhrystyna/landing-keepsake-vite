section#works.section.works
  .container
    .section-heading.works__head
      h2 Our awesome works
      .works-filter(aria-label='Filter portfolio')
        each category, i in categories
          input(type='radio' name='work-filter' id=`filter-${category.id}` value=category.id checked=i === 0)
          label(for=`filter-${category.id}`)= category.label
    .works-grid
      each work, i in works
        +work-card(work, i)
    .works__more
      button.btn.btn--secondary(type='button' id='load-more') Load more works
