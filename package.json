{
  "name": "landing-keepsake-vite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "lint": "npm run lint:styles && npm run lint:format",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "lint:format": "prettier --check .",
    "images": "node scripts/generate-images.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@prettier/plugin-pug": "^3.4.2",
    "@vituum/vite-plugin-pug": "^1.1.0",
    "autoprefixer": "^10.6.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "postcss": "^8.5.33",
    "prettier": "^3.4.2",
    "sass": "^1.83.0",
    "sharp": "^0.33.5",
    "stylelint": "^16.12.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "vite": "^6.0.5",
    "vituum": "^1.2.0"
  },
  "lint-staged": {
    "*.scss": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{pug,js,json,md}": [
      "prettier --write"
    ]
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Edge versions",
    "last 2 Safari versions",
    "last 2 iOS versions"
  ]
}
